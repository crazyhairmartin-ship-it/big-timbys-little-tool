{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Big Timby's Little Tool",
  "version": "0.1.0",
  "identifier": "com.bigtimby.combotracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "windows": [
      {
        "title": "Big Timby's Little Tool",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0f1320"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "rpm", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "OSRS combination item margin tracker",
    "longDescription": "Live profit tracker for OSRS combination items with GE tax, real-time prices from the OSRS Wiki API, historical charts, and trade-volume-aware margin estimates."
  }
}
